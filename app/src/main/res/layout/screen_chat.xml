<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="8dp" android:gravity="center_vertical" android:background="@color/aiva_background">
        <TextView android:id="@+id/chat_back" style="@style/SmallPillButton" android:text="‹" android:textSize="24sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
            <TextView android:id="@+id/chat_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Conversation" android:textColor="@color/aiva_text" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/chat_model" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No model selected" android:textColor="@color/aiva_muted" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/chat_voice" style="@style/SmallPillButton" android:text="◉" android:textSize="18sp" />
        <TextView android:id="@+id/chat_choose_model" style="@style/SmallPillButton" android:text="Model" />
    </LinearLayout>
    <TextView android:id="@+id/chat_warning" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:textSize="12sp" android:textColor="@color/aiva_muted" android:visibility="gone" />
    <ScrollView android:id="@+id/chat_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/chat_messages" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="16dp" />
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="10dp" android:background="@color/aiva_background">
        <TextView android:id="@+id/chat_attachment_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/aiva_muted" android:textSize="12sp" android:visibility="gone" />
        <HorizontalScrollView android:id="@+id/chat_attachment_scroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:scrollbars="none">
            <LinearLayout android:id="@+id/chat_attachment_strip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="6dp" />
        </HorizontalScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:background="@drawable/bg_card" android:padding="8dp">
            <TextView android:id="@+id/chat_attach" style="@style/SmallPillButton" android:text="＋" android:textSize="20sp" />
            <EditText android:id="@+id/chat_message" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:maxLines="5" android:gravity="center_vertical|start" android:hint="Message AIVA…" android:background="@android:color/transparent" android:padding="8dp" android:textColor="@color/aiva_text" android:textColorHint="@color/aiva_muted" android:inputType="textCapSentences|textMultiLine" />
            <TextView android:id="@+id/chat_stop" style="@style/SmallPillButton" android:text="Stop" android:visibility="gone" />
            <TextView android:id="@+id/chat_send" style="@style/PrimaryPillButton" android:text="➤" android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
