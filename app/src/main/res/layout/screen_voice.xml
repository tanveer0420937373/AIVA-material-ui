<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/aiva_background"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="10dp"
    android:paddingBottom="12dp">

    <!-- Compact header: navigation, stable title and settings. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/voice_close"
            style="@style/SmallPillButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:minWidth="44dp"
            android:padding="0dp"
            android:text="‹"
            android:textSize="28sp"
            android:contentDescription="Back" />
        <TextView
            android:id="@+id/voice_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="AIVA Voice"
            android:textColor="@color/aiva_text"
            android:textSize="18sp"
            android:fontFamily="sans"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/voice_settings"
            style="@style/SmallPillButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:minWidth="44dp"
            android:padding="0dp"
            android:text="⚙"
            android:textSize="20sp"
            android:contentDescription="Voice settings" />
    </LinearLayout>

    <!-- Model is a separate compact selector, not part of the title. -->
    <TextView
        android:id="@+id/voice_model"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_voice_model"
        android:drawableEnd="@android:drawable/arrow_down_float"
        android:drawablePadding="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxWidth="300dp"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:text="Choose AI model"
        android:textColor="@color/aiva_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Choose AI model" />

    <!-- Flexible centre area lets the orb adapt to short screens. The HTML orb WebView is added
         here at runtime (OrbController); the static image below is the fallback if it cannot load. -->
    <FrameLayout
        android:id="@+id/voice_orb_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="156dp"
        android:layout_marginTop="4dp">
        <ImageView
            android:id="@+id/voice_orb"
            android:layout_width="232dp"
            android:layout_height="232dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="AIVA animated voice orb"
            android:scaleType="fitCenter"
            android:src="@drawable/aiva_orb" />
    </FrameLayout>

    <TextView
        android:id="@+id/voice_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Ready when you are"
        android:textColor="@color/aiva_text"
        android:textSize="25sp"
        android:fontFamily="sans"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/voice_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:minHeight="20dp"
        android:text="Start once, then speak naturally"
        android:textColor="@color/aiva_muted"
        android:textSize="14sp" />

    <!-- Transcript is compact by default; longer content remains readable. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_voice_panel"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LIVE TRANSCRIPT"
                android:textColor="@color/aiva_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
            <TextView
                android:id="@+id/voice_transcript_toggle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Expand"
                android:textColor="@color/aiva_primary"
                android:textSize="12sp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
        <TextView
            android:id="@+id/voice_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Your words and AIVA’s replies will appear here."
            android:textColor="@color/aiva_text"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Four explicit controls avoid overloading the microphone button. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/voice_mute"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_voice_control"
                android:gravity="center"
                android:text="♩"
                android:textColor="@color/aiva_text"
                android:textSize="22sp"
                android:contentDescription="Mute microphone"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/voice_mute_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Mute"
                android:textColor="@color/aiva_muted"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.25"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/voice_mic"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_voice_mic"
                android:gravity="center"
                android:text="🎙"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:contentDescription="Start continuous voice conversation"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/voice_mic_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Start"
                android:textColor="@color/aiva_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/voice_interrupt"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_voice_control"
                android:gravity="center"
                android:text="Ⅱ"
                android:textColor="@color/aiva_text"
                android:textSize="22sp"
                android:contentDescription="Interrupt AIVA response"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/voice_interrupt_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Interrupt"
                android:textColor="@color/aiva_muted"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/voice_end"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_voice_end"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/aiva_danger"
                android:textSize="28sp"
                android:contentDescription="End voice conversation"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="End"
                android:textColor="@color/aiva_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
